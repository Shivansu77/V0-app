generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  image String?
  clerkId String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}